+        # b70 local patch: VLLM_XPU_ISOLATE_WORKERS=1 gives each worker a
+        # single-device Level Zero context (avoids the multi-device host-RAM
+        # mirror, intel/compute-runtime#980).
+        _iso = os.environ.get("VLLM_XPU_ISOLATE_WORKERS") == "1"
+        _saved_mask = os.environ.get("ZE_AFFINITY_MASK")
+        if _iso:
+            _ids = _saved_mask.split(",") if _saved_mask else None
+            os.environ["ZE_AFFINITY_MASK"] = _ids[local_rank] if _ids else str(local_rank)
+        try:
+            with numa_utils.configure_subprocess(
+                vllm_config, local_rank, process_kind="worker"
+            ):
+                proc.start()
+        finally:
+            if _iso:
+                if _saved_mask is None:
+                    os.environ.pop("ZE_AFFINITY_MASK", None)
+                else:
+                    os.environ["ZE_AFFINITY_MASK"] = _saved_mask
 
         # Close child ends of pipes here in the parent
         ready_writer.close()
