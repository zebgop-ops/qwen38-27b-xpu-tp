+                fp8 = torch.float8_e4m3fn
+                fmax = torch.finfo(fp8).max
+                wq = torch.empty(w.shape, dtype=fp8, device=w.device)
+                cs = torch.empty(w.shape[0], dtype=torch.float32, device=w.device)
+                for r0 in range(0, w.shape[0], 8192):
+                    blk = w[r0 : r0 + 8192].float()
+                    sc = blk.abs().amax(1).clamp(min=1e-12) / fmax
+                    wq[r0 : r0 + 8192] = (blk / sc[:, None]).clamp(-fmax, fmax).to(fp8)
