+class _XpuSymmAllReduce:
+    """b70 local patch (VLLM_XPU_SYMM_AR=1): graph-capturable all-reduce.
+
+    oneCCL collectives cannot be recorded into XPU (SYCL) graphs. During graph
+    capture we instead stage the input in a torch symmetric-memory buffer,
+    sync with device-side barriers (SYCL kernels) and sum the peers' buffers
+    via P2P loads, so the whole all-reduce is ordinary recordable kernels.
+    """
+
+    def __init__(self, group: ProcessGroup, device: torch.device, max_bytes: int):
+        import torch.distributed._symmetric_memory as symm_mem
+
+        self.max_bytes = max_bytes
+        self.buf = symm_mem.empty(max_bytes, dtype=torch.uint8, device=device)
+        self.hdl = symm_mem.rendezvous(self.buf, group.group_name)
+        self.world_size = self.hdl.world_size
+        self.bufs = [
+            self.hdl.get_buffer(i, (max_bytes,), torch.uint8)
+            for i in range(self.world_size)
+        ]
+        self.local = self.bufs[self.hdl.rank]
+
+    def fits(self, x: torch.Tensor) -> bool:
+        nbytes = x.numel() * x.element_size()
+        return x.is_contiguous() and nbytes <= self.max_bytes and nbytes % 4 == 0
+
+    def all_reduce(self, x: torch.Tensor) -> torch.Tensor:
+        n, dt = x.numel(), x.dtype
+        self.local.view(dt)[:n].copy_(x.reshape(-1))
+        self.hdl.barrier(channel=0)
+        # Same summation order on every rank -> bit-identical results.
+        out = self.bufs[0].view(dt)[:n] + self.bufs[1].view(dt)[:n]
+        for i in range(2, self.world_size):
+            out += self.bufs[i].view(dt)[:n]
+        self.hdl.barrier(channel=1)  # peers done reading before buffer reuse
+        return out.view_as(x)
+
+    def all_gather(self, x: torch.Tensor, dim: int) -> torch.Tensor:
+        n, dt = x.numel(), x.dtype
+        self.local.view(dt)[:n].copy_(x.reshape(-1))
+        self.hdl.barrier(channel=0)
+        out = torch.cat([b.view(dt)[:n].view(x.shape) for b in self.bufs], dim=dim)
+        self.hdl.barrier(channel=1)
+        return out
+
+
+def _capturing() -> bool:
+    return torch.xpu.is_current_stream_capturing()
+
+
